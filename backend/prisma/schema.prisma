/// ─────────────────────────────────────────────────────────────────────────────
/// SunSense Database Schema (Prisma)
///
/// This file is the single source of truth for the SunSense PostgreSQL database.
/// Every model, enum, relationship, index, and constraint is defined here.
///
/// Architecture:
/// - 10 tables supporting the MVP: 1 User → 1 Device
/// - All IDs are UUIDs (Postgres `uuid` type with @default(uuid()))
/// - All timestamps use Timestamp(6) (microsecond precision)
/// - Table names use snake_case via @@map() for Postgres convention
/// - Field names use camelCase in Prisma, snake_case in the DB via @map()
/// - All foreign keys cascade on delete to maintain referential integrity
///
/// Extending for Multi-Device (V2):
/// - Remove @unique from Device.userId
/// - Add DeviceId to ExposureSession-level aggregates
/// - Update all "1 device per user" guards in the service layer
/// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Enums
/// ─────────────────────────────────────────────────────────────────────────────

/// UV exposure risk level classification following the WHO UV Index scale.
///
/// Used by:
/// - exposure_sessions.calculated_risk   → Peak risk during a session
/// - ExposureLogicService.calculateRisk() → Assigned per reading batch
///
/// WHO Thresholds:
/// LOW       UVI < 3
/// MODERATE  UVI 3–5.9
/// HIGH      UVI 6–7.9
/// VERY_HIGH UVI 8–10.9
/// EXTREME   UVI ≥ 11
enum RiskLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  EXTREME
}

/// Categories of smart alerts generated by the system.
///
/// Used by:
/// - alerts.type field
/// - Phase 8 Smart Alert Engine
///
/// Alert meanings:
/// BURN_WARNING      → User has exceeded their safe burn time
/// REAPPLY_SUNSCREEN → Sunscreen protection has expired or is near expiry
/// DAILY_LIMIT       → User has reached their recommended daily SED limit
/// OFFLINE_SYNC      → Device reconnected and uploaded queued offline readings
/// BATTERY_LOW       → Device battery is below the critical threshold (20%)
enum AlertType {
  BURN_WARNING
  REAPPLY_SUNSCREEN
  DAILY_LIMIT
  OFFLINE_SYNC
  BATTERY_LOW
}

/// Status codes for offline sync operations logged in device_sync_logs.
///
/// SUCCESS → All queued readings were uploaded successfully
/// PARTIAL → Some readings failed (e.g., duplicate conflicts)
/// FAILED  → The sync upload failed entirely
enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Models
/// ─────────────────────────────────────────────────────────────────────────────

/// Represents a registered SunSense user.
///
/// Relationships (MVP: 1 User → 1 Device):
/// - User → Device                (1-to-1, cascade delete)
/// - User → SunscreenApplications (1-to-many, cascade delete)
/// - User → Alerts                (1-to-many, cascade delete)
/// - User → Setting               (1-to-1, cascade delete)
/// - User → NotificationPreference (1-to-1, cascade delete)
/// - User → ExposureSessions      (1-to-many, cascade delete)
///
/// Notes:
/// - skinType: Fitzpatrick scale (1=very fair, 6=dark)
///   Used by CalculationService to personalise burn time and SPF recommendations.
/// - preferredSpf: User's preferred sunscreen SPF.
///   Used as default in the sunscreen tracker UI.
/// - passwordHash is NEVER returned in API responses (filtered in ProfileRepository).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)       // Unique index for fast login lookups
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String?  @db.VarChar(255)
  skinType     Int      @map("skin_type") @db.SmallInt  // 1–6 Fitzpatrick scale
  preferredSpf Int      @map("preferred_spf") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  device                  Device?
  sunscreenApplications   SunscreenApplication[]
  alerts                  Alert[]
  settings                Setting?
  notificationPreferences NotificationPreference?
  exposureSessions        ExposureSession[]

  @@map("users")
}

/// Represents the ESP8266 hardware device registered to a user.
///
/// MVP Constraint:
/// The @unique on userId enforces exactly one device per user at the database level.
/// The DeviceService also enforces this at the application level for a clearer error message.
///
/// Relationships:
/// - Device → User           (many-to-1, cascade delete from User)
/// - Device → DeviceToken    (1-to-1)
/// - Device → UVReadings     (1-to-many)
/// - Device → ExposureSessions (1-to-many)
/// - Device → DeviceSyncLogs (1-to-many)
///
/// Notes:
/// - lastPing: Updated by DeviceIngestionService on every reading batch.
///   Used by DashboardService to determine ONLINE/OFFLINE status.
///   ONLINE = lastPing within the past 5 minutes.
model Device {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid    // @unique = 1 device per user (MVP)
  name            String    @db.VarChar(255)
  firmwareVersion String?   @map("firmware_version") @db.VarChar(50)
  batteryLevel    Int?      @map("battery_level") @db.SmallInt  // 0–100 percent
  wifiSsid        String?   @map("wifi_ssid") @db.VarChar(255)
  ipAddress       String?   @map("ip_address") @db.VarChar(50)
  lastPing        DateTime? @map("last_ping") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken      DeviceToken?
  uvReadings       UVReading[]
  exposureSessions ExposureSession[]
  deviceSyncLogs   DeviceSyncLog[]

  @@map("devices")
}

/// Stores the bcrypt-hashed API key used by the ESP8266 for authentication.
///
/// Security Architecture:
/// - The plaintext API key is generated once at device registration (64-char hex).
/// - Only the bcrypt hash is stored here. The plaintext is NEVER persisted.
/// - On each request, the ESP8266 sends the plaintext key in the `x-api-key` header.
/// - requireDeviceAuth middleware uses bcrypt.compare() to verify.
///
/// Relationship:
/// - DeviceToken → Device (1-to-1, the deviceId IS the primary key)
///
/// Notes:
/// - lastUsedAt: Updated by requireDeviceAuth on every successful authentication.
///   Useful for detecting devices that have stopped sending data.
model DeviceToken {
  deviceId   String    @id @map("device_id") @db.Uuid    // PK = device UUID (1-to-1 with Device)
  apiKeyHash String    @map("api_key_hash") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

/// Stores raw UV Index readings from the S12SD sensor on the ESP8266.
///
/// This is the primary time-series data table. Every reading sent by the
/// device is stored here permanently. The ExposureLogicService processes
/// these into aggregated ExposureSessions.
///
/// Unique Constraint:
/// (device_id, recorded_at) prevents duplicate readings from being inserted.
/// This is the key safety net for the offline sync / reconnection scenario
/// where the device may re-send the same batch.
///
/// Indexes:
/// - device_id    → Fast filtering for session window queries
/// - recorded_at  → Fast time-range queries for session and analytics
///
/// Notes:
/// - uvIndex uses Decimal(4,2) to store values like 11.34 accurately
///   without floating-point precision errors.
/// - recordedAt = time the SENSOR recorded the reading (device time, synced via /server/time).
/// - createdAt   = time the SERVER received and stored the reading.
model UVReading {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  uvIndex    Decimal  @map("uv_index") @db.Decimal(4, 2)    // Range: 0.00–20.00
  recordedAt DateTime @map("recorded_at") @db.Timestamp(6)   // Device timestamp
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6) // Server receive time

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, recordedAt])  // Prevents duplicate offline-sync submissions
  @@index([deviceId])               // Fast device-scoped queries
  @@index([recordedAt])             // Fast time-range queries
  @@map("uv_readings")
}

/// Represents a computed period of continuous sun exposure.
///
/// Purpose:
/// Rather than recalculating SED and risk from thousands of raw UV readings
/// on every dashboard/analytics request, the ExposureLogicService maintains
/// pre-computed session records. This is the analytics pre-computation layer.
///
/// Session Lifecycle:
/// 1. Created: When first UV reading > 0 after a 15+ minute gap (or at start of day).
/// 2. Updated: Each new reading within 15 minutes of the last extends the session.
/// 3. Closed: Implicitly — when no new reading arrives for > 15 minutes, the next
///    reading starts a new session. The last session's endTime is its "close" time.
///
/// Indexes:
/// - user_id → Fast queries for all of a user's sessions (analytics, history)
///
/// Notes:
/// - calculatedRisk = peak risk level (based on max UV reading, not average)
/// - accumulatedSed uses Decimal(6,2) for accuracy (max ~999.99 SED units)
model ExposureSession {
  sessionId       String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  startTime       DateTime  @map("start_time") @db.Timestamp(6)
  endTime         DateTime  @map("end_time") @db.Timestamp(6)
  durationSeconds Int       @map("duration_seconds")
  averageUvIndex  Decimal   @map("average_uv_index") @db.Decimal(4, 2)
  accumulatedSed  Decimal   @map("accumulated_sed") @db.Decimal(6, 2)
  calculatedRisk  RiskLevel @map("calculated_risk")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])               // Fast user-scoped session queries
  @@map("exposure_sessions")
}

/// Records when a user applies sunscreen and when protection expires.
///
/// Business Rule:
/// Sunscreen expires exactly 2 hours (120 minutes) after application,
/// regardless of SPF. The SPF value is stored for logging/analytics only.
///
/// Relationship:
/// - SunscreenApplication → User (many-to-1, cascade delete)
///
/// Indexes:
/// - user_id → Fast lookup of latest application for dashboard countdown
model SunscreenApplication {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  appliedSpf Int      @map("applied_spf") @db.SmallInt
  appliedAt  DateTime @map("applied_at") @db.Timestamp(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)  // = appliedAt + 120 minutes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sunscreen_applications")
}

/// Stores smart alerts generated by the system for the user.
///
/// Alert Generation:
/// Alerts are NOT generated by user actions. They are generated by the
/// Smart Alert Engine (Phase 8) based on UV thresholds, sunscreen expiry,
/// battery levels, and daily exposure limits.
///
/// Alert Lifecycle:
/// - isRead = false by default; set to true when user views the alert.
/// - isDismissed = false by default; set to true when user permanently dismisses it.
/// - Dismissed alerts are hidden from all API responses (never shown again).
///
/// Relationship:
/// - Alert → User (many-to-1, cascade delete)
///
/// Indexes:
/// - user_id → Fast queries for the user's alert list
model Alert {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        AlertType
  message     String    @db.Text
  triggeredAt DateTime  @map("triggered_at") @db.Timestamp(6)
  isRead      Boolean   @default(false) @map("is_read")
  isDismissed Boolean   @default(false) @map("is_dismissed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alerts")
}

/// Stores the user's dashboard configuration and UV alert threshold.
///
/// Design:
/// The userId IS the primary key (1-to-1 with User).
/// There is exactly one settings row per user.
///
/// alertThreshold:
/// The UV Index value above which the Smart Alert Engine (Phase 8)
/// will fire a BURN_WARNING or HIGH_RISK alert for this user.
/// Default set during seeding is 6.0 (HIGH risk boundary per WHO scale).
///
/// Relationship:
/// - Setting → User (1-to-1, cascade delete)
model Setting {
  userId         String   @id @map("user_id") @db.Uuid    // PK = user UUID (1-to-1)
  alertThreshold Decimal  @map("alert_threshold") @db.Decimal(4, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

/// Stores the user's notification delivery preferences.
///
/// Design:
/// The userId IS the primary key (1-to-1 with User).
/// smartAlertPreferences and reminderPreferences are stored as JSONB
/// for flexible, fine-grained alert type toggles without schema changes.
///
/// quietHoursStart / quietHoursEnd:
/// Time-of-day window during which alerts should NOT be delivered.
/// Currently defaulted to midnight UTC. Configurable UI is planned for Phase 8.
///
/// Relationship:
/// - NotificationPreference → User (1-to-1, cascade delete)
model NotificationPreference {
  userId                String   @id @map("user_id") @db.Uuid    // PK = user UUID (1-to-1)
  emailNotifications    Boolean  @default(true) @map("email_notifications")
  pushNotifications     Boolean  @default(true) @map("push_notifications")
  smartAlertPreferences Json     @default("{}") @map("smart_alert_preferences") @db.JsonB
  reminderPreferences   Json     @default("{}") @map("reminder_preferences") @db.JsonB
  quietHoursStart       DateTime @map("quiet_hours_start") @db.Time()
  quietHoursEnd         DateTime @map("quiet_hours_end") @db.Time()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Audit log for offline synchronisation bursts from the ESP8266.
///
/// Purpose:
/// When the ESP8266 reconnects after being offline, it uploads a batch of
/// queued readings. This table records each sync event for:
/// - Debugging connectivity issues
/// - Auditing data completeness
/// - Generating OFFLINE_SYNC alerts
///
/// recordsUploaded: Number of readings included in the sync batch.
/// status: Whether all, some, or none of the readings were accepted.
///
/// Relationship:
/// - DeviceSyncLog → Device (many-to-1, cascade delete)
model DeviceSyncLog {
  id              String     @id @default(uuid()) @db.Uuid
  deviceId        String     @map("device_id") @db.Uuid
  syncTime        DateTime   @map("sync_time") @db.Timestamp(6)
  recordsUploaded Int        @map("records_uploaded")
  status          SyncStatus

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_sync_logs")
}
