generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  EXTREME
}

enum AlertType {
  BURN_WARNING
  REAPPLY_SUNSCREEN
  DAILY_LIMIT
  OFFLINE_SYNC
  BATTERY_LOW
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String?  @db.VarChar(255)
  skinType     Int      @map("skin_type") @db.SmallInt // 1-6
  preferredSpf Int      @map("preferred_spf") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  device                  Device?
  sunscreenApplications   SunscreenApplication[]
  alerts                  Alert[]
  settings                Setting?
  notificationPreferences NotificationPreference?
  exposureSessions        ExposureSession[]

  @@map("users")
}

model Device {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  name            String    @db.VarChar(255)
  firmwareVersion String?   @map("firmware_version") @db.VarChar(50)
  batteryLevel    Int?      @map("battery_level") @db.SmallInt // 0-100
  wifiSsid        String?   @map("wifi_ssid") @db.VarChar(255)
  ipAddress       String?   @map("ip_address") @db.VarChar(50)
  lastPing        DateTime? @map("last_ping") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken      DeviceToken?
  uvReadings       UVReading[]
  exposureSessions ExposureSession[]
  deviceSyncLogs   DeviceSyncLog[]

  @@map("devices")
}

model DeviceToken {
  deviceId   String    @id @map("device_id") @db.Uuid
  apiKeyHash String    @map("api_key_hash") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model UVReading {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  uvIndex    Decimal  @map("uv_index") @db.Decimal(4, 2)
  recordedAt DateTime @map("recorded_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, recordedAt])
  @@index([deviceId])
  @@index([recordedAt])
  @@map("uv_readings")
}

model ExposureSession {
  sessionId       String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  startTime       DateTime  @map("start_time") @db.Timestamp(6)
  endTime         DateTime  @map("end_time") @db.Timestamp(6)
  durationSeconds Int       @map("duration_seconds")
  averageUvIndex  Decimal   @map("average_uv_index") @db.Decimal(4, 2)
  accumulatedSed  Decimal   @map("accumulated_sed") @db.Decimal(6, 2)
  calculatedRisk  RiskLevel @map("calculated_risk")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("exposure_sessions")
}

model SunscreenApplication {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  appliedSpf Int      @map("applied_spf") @db.SmallInt
  appliedAt  DateTime @map("applied_at") @db.Timestamp(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sunscreen_applications")
}

model Alert {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        AlertType
  message     String    @db.Text
  triggeredAt DateTime  @map("triggered_at") @db.Timestamp(6)
  isRead      Boolean   @default(false) @map("is_read")
  isDismissed Boolean   @default(false) @map("is_dismissed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alerts")
}

model Setting {
  userId         String   @id @map("user_id") @db.Uuid
  alertThreshold Decimal  @map("alert_threshold") @db.Decimal(4, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model NotificationPreference {
  userId                String   @id @map("user_id") @db.Uuid
  emailNotifications    Boolean  @default(true) @map("email_notifications")
  pushNotifications     Boolean  @default(true) @map("push_notifications")
  smartAlertPreferences Json     @default("{}") @map("smart_alert_preferences") @db.JsonB
  reminderPreferences   Json     @default("{}") @map("reminder_preferences") @db.JsonB
  quietHoursStart       DateTime @map("quiet_hours_start") @db.Time()
  quietHoursEnd         DateTime @map("quiet_hours_end") @db.Time()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model DeviceSyncLog {
  id              String     @id @default(uuid()) @db.Uuid
  deviceId        String     @map("device_id") @db.Uuid
  syncTime        DateTime   @map("sync_time") @db.Timestamp(6)
  recordsUploaded Int        @map("records_uploaded")
  status          SyncStatus

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_sync_logs")
}
