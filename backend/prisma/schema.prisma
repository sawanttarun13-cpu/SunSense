generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  name          String?  @db.VarChar(255)
  skin_type     Int      @db.SmallInt // 1-6
  preferred_spf Int      @db.SmallInt
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  devices                  Device[]
  sunscreen_applications   SunscreenApplication[]
  alerts                   Alert[]
  settings                 Setting?
  notification_preferences NotificationPreference?
  exposure_sessions        ExposureSession[]

  @@map("users")
}

model Device {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  name             String    @db.VarChar(255)
  firmware_version String?   @db.VarChar(50)
  battery_level    Int?      @db.SmallInt // 0-100
  wifi_ssid        String?   @db.VarChar(255)
  ip_address       String?   @db.VarChar(50)
  last_ping        DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device_token      DeviceToken?
  uv_readings       UVReading[]
  exposure_sessions ExposureSession[]
  device_sync_logs  DeviceSyncLog[]

  @@map("devices")
}

model DeviceToken {
  device_id    String    @id @db.Uuid
  api_key_hash String    @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  last_used_at DateTime? @db.Timestamp(6)

  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model UVReading {
  id          String   @id @default(uuid()) @db.Uuid
  device_id   String   @db.Uuid
  uv_index    Decimal  @db.Decimal(4, 2)
  recorded_at DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([device_id, recorded_at])
  @@index([device_id])
  @@index([recorded_at])
  @@map("uv_readings")
}

model ExposureSession {
  session_id       String   @id @default(uuid()) @db.Uuid
  user_id          String   @db.Uuid
  device_id        String   @db.Uuid
  start_time       DateTime @db.Timestamp(6)
  end_time         DateTime @db.Timestamp(6)
  duration_seconds Int
  average_uv_index Decimal  @db.Decimal(4, 2)
  accumulated_sed  Decimal  @db.Decimal(6, 2)
  calculated_risk  String   @db.VarChar(50)
  created_at       DateTime @default(now()) @db.Timestamp(6)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("exposure_sessions")
}

model SunscreenApplication {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  applied_spf Int      @db.SmallInt
  applied_at  DateTime @db.Timestamp(6)
  expires_at  DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sunscreen_applications")
}

model Alert {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  type         String   @db.VarChar(50)
  message      String   @db.Text
  triggered_at DateTime @db.Timestamp(6)
  is_read      Boolean  @default(false)
  is_dismissed Boolean  @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("alerts")
}

model Setting {
  user_id               String   @id @db.Uuid
  alert_threshold       Decimal  @db.Decimal(4, 2)
  notifications_enabled Boolean  @default(true)
  email_alerts          Boolean  @default(false)
  updated_at            DateTime @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("settings")
}

model NotificationPreference {
  user_id                 String   @id @db.Uuid
  email_notifications     Boolean  @default(true)
  push_notifications      Boolean  @default(true)
  smart_alert_preferences Json     @default("{}")
  reminder_preferences    Json     @default("{}")
  quiet_hours_start       DateTime @db.Time()
  quiet_hours_end         DateTime @db.Time()
  updated_at              DateTime @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model DeviceSyncLog {
  id               String   @id @default(uuid()) @db.Uuid
  device_id        String   @db.Uuid
  sync_time        DateTime @db.Timestamp(6)
  records_uploaded Int
  status           String   @db.VarChar(50)

  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@map("device_sync_logs")
}
